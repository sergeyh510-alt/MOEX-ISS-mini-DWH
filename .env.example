# Пример переменных окружения. Скопируйте в .env и при необходимости измените:
#   copy .env.example .env           (Windows PowerShell)
#   cp .env.example .env             (bash)
#
# Сам файл .env в репозиторий не попадает (см. .gitignore).
# Все значения ниже - dev-заглушки. Реальные секреты в репозиторий не кладём.
# Если .env отсутствует, docker-compose.yml использует те же значения по умолчанию.

# --- Веб-интерфейс Airflow ---
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Секреты Airflow ---
# FERNET_KEY шифрует секреты соединений в метаданных Airflow.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=
WEBSERVER_SECRET_KEY=change-me-dev-only-secret-key

# --- БД метаданных Airflow ---
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_PG_HOST_PORT=5434

# --- БД мини-DWH ---
DWH_DB_USER=dwh
DWH_DB_PASSWORD=dwh
DWH_DB_NAME=moex_dwh
DWH_PG_HOST_PORT=5433

# --- MOEX ISS API (клиент загрузки) ---
MOEX_ISS_BASE_URL=https://iss.moex.com
MOEX_ISS_PAGE_SIZE=100
MOEX_ISS_TIMEOUT=30
MOEX_ISS_MAX_RETRIES=5
MOEX_ISS_BACKOFF_FACTOR=0.5

# --- Права файлов (Linux). На Windows можно оставить как есть. ---
AIRFLOW_UID=50000